# ============================================================
#  StudyGen AI - Environment Configuration Template
#  Copy this file to .env and fill in your credentials.
#  NEVER commit .env to version control.
# ============================================================

# -- IBM watsonx.ai Credentials --------------------------------
IBM_WATSONX_API_KEY=your_ibm_watsonx_api_key_here
IBM_WATSONX_PROJECT_ID=your_ibm_watsonx_project_id_here
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# -- Granite Model IDs -----------------------------------------
GRANITE_CHAT_MODEL=ibm/granite-4-h-small
GRANITE_EMBEDDING_MODEL=ibm/slate-125m-english-rtrvr-v2

# -- Flask Settings --------------------------------------------
FLASK_SECRET_KEY=change-me-to-a-random-secret-string
FLASK_DEBUG=False
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# -- Upload Settings -------------------------------------------
MAX_CONTENT_LENGTH_MB=50
UPLOAD_FOLDER=uploads
ALLOWED_EXTENSIONS=pdf

# -- RAG / FAISS Settings --------------------------------------
FAISS_INDEX_PATH=data/faiss_index
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RESULTS=5
